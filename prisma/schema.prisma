// Prisma Schema for Soft4U Digital Commerce
// Production-grade PostgreSQL / Prisma definition

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  FULFILLED
  PARTIALLY_FULFILLED
}

enum InventoryType {
  CREDENTIAL
  LICENSE_KEY
  MANUAL
  GENERATED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
  EXPIRED
}

enum TicketStatus {
  OPEN
  PENDING
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewStatus {
  APPROVED
  PENDING
  HIDDEN
  REJECTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(CUSTOMER)
  phone        String?
  whatsapp     String?
  telegram     String?
  avatar       String?
  status       String        @default("active") // active, suspended
  orders       Order[]
  tickets      SupportTicket[]
  reviews      Review[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([role])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  icon           String?
  banner         String?
  parentId       String?
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  status         String     @default("active")
  displayOrder   Int        @default(0)
  featured       Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  sku               String?
  shortDescription  String
  longDescription   String
  images            String[]
  logo              String?
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  tags              String[]
  price             Decimal          @db.Decimal(10, 2)
  compareAtPrice    Decimal?         @db.Decimal(10, 2)
  discount          Int              @default(0)
  status            String           @default("active") // active, draft, disabled, archived
  featured          Boolean          @default(false)
  bestseller        Boolean          @default(false)
  isNew             Boolean          @default(false)
  trending          Boolean          @default(false)
  badge             String?
  deliveryTime      String           @default("Instant (within 5 minutes)")
  deliveryMethod    String           @default("Automated Email & Dashboard")
  productType       String           @default("Digital Subscription")
  inventoryModel    InventoryType    @default(CREDENTIAL)
  features          String[]
  requirements      String[]
  usageInstructions String?
  refundInfo        String?
  seoTitle          String?
  seoDescription    String?
  relatedProductIds String[]
  variants          ProductVariant[]
  inventoryItems    InventoryItem[]
  reviews           Review[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  price          Decimal         @db.Decimal(10, 2)
  compareAtPrice Decimal?        @db.Decimal(10, 2)
  sku            String?
  stock          Int             @default(999)
  description    String?
  features       String[]
  deliveryMethod String?
  deliveryTime   String?
  status         String          @default("active")
  expiryDays     Int?
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
}

model InventoryItem {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type          InventoryType   @default(CREDENTIAL)
  data          Json            // Encrypted or structured: { email, password, licenseKey, pin, notes }
  status        InventoryStatus @default(AVAILABLE)
  orderId       String?
  orderItemId   String?
  soldAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([status])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  customerId        String?
  customer          User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  customerWhatsapp  String?
  subtotal          Decimal           @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  couponCode        String?
  tax               Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  paymentMethod     String
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  orderStatus       OrderStatus       @default(PENDING)
  timeline          Json              // Array of { status, note, timestamp }
  items             OrderItem[]
  payments          Payment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([orderStatus])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  productName     String
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  variantName     String
  price           Decimal         @db.Decimal(10, 2)
  quantity        Int             @default(1)
  fulfillmentData Json?           // { credentials: [...], licenseKeys: [...], instructions: "..." }
  createdAt       DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  gateway       String
  transactionId String?
  status        PaymentStatus @default(PENDING)
  payload       Json?
  createdAt     DateTime      @default(now())

  @@index([orderId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           String    // "percentage" | "fixed"
  value          Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal?  @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int       @default(0)
  perUserLimit   Int?      @default(1)
  startDate      DateTime?
  expiryDate     DateTime?
  enabled        Boolean   @default(true)
  productIds     String[]
  categoryIds    String[]
  createdAt      DateTime  @default(now())

  @@index([code])
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  customerId   String?
  customer     User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  customerEmail String
  subject      String
  orderId      String?
  productId    String?
  category     String         @default("General Inquiry")
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  messages     Json           // Array of { id, senderId, senderName, senderRole, message, attachments, isInternalNote, timestamp }
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ticketNumber])
  @@index([customerEmail])
  @@index([status])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean      @default(true)
  status           ReviewStatus @default(APPROVED)
  isFeatured       Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([productId])
  @@index([status])
}

model Announcement {
  id        String    @id @default(cuid())
  text      String
  link      String?
  ctaText   String?
  startDate DateTime?
  endDate   DateTime?
  priority  Int       @default(0)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  ctaText     String?
  url         String?
  startDate   DateTime?
  endDate     DateTime?
  priority    Int       @default(0)
  position    String    @default("hero_bottom")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
}

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  status       String   @default("active")
  productId    String?
  categoryId   String?
  createdAt    DateTime @default(now())
}

model Testimonial {
  id            String   @id @default(cuid())
  name          String
  roleOrCompany String?
  avatar        String?
  rating        Int      @default(5)
  content       String
  featured      Boolean  @default(false)
  displayOrder  Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
}

model NavigationItem {
  id           String   @id @default(cuid())
  label        String
  url          String
  icon         String?
  parentId     String?
  displayOrder Int      @default(0)
  visible      Boolean  @default(true)
  targetBlank  Boolean  @default(false)
  position     String   @default("header") // header, footer, mobile
  createdAt    DateTime @default(now())
}

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(PUBLISHED)
  revisions       Json          // Array of { version, title, content, publishedAt, author }
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

model LegalPage {
  id              String        @id @default(cuid())
  slug            String        @unique // terms, privacy, refund-policy, cookie-policy, shipping-policy
  title           String
  content         String
  status          ContentStatus @default(PUBLISHED)
  lastPublishedAt DateTime      @default(now())
  revisions       Json          // Array of { version, content, publishedAt, note }
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

model AuditLog {
  id            String   @id @default(cuid())
  adminEmail    String
  adminName     String
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  timestamp     DateTime @default(now())
  ipAddress     String?

  @@index([entity])
  @@index([timestamp])
}

model SiteSetting {
  id        String   @id @default("default")
  data      Json     // General, branding, appearance, checkout, SEO, social, notifications, AI support
  updatedAt DateTime @updatedAt
}
