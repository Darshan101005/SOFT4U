# GEMINI_API_KEY: optional, used by the AI support assistant (/api/ai-support).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the public URL of the site.
APP_URL="https://soft4u.top"

# Database Connection (PostgreSQL or local SQLite/JSON fallback)
DATABASE_URL="postgresql://user:password@localhost:5432/soft4u_db"

# Authentication & Session Security
AUTH_SECRET="super-secure-random-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional Email Provider (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_KEY=""
EMAIL_FROM_ADDRESS="support@soft4u.top"

# Payment Gateways (Stripe, Razorpay, Crypto, Manual Wire)
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Media Storage (Cloudinary / S3 / Local fallback)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
